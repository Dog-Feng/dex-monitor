[Unit]
Description=Token Anomaly Monitor (poll + web dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tam
Group=tam
WorkingDirectory=/opt/token-anomaly-monitor
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/token-anomaly-monitor/.venv/bin/python main.py
Restart=on-failure
RestartSec=10

# 资源限制（可按需调整）
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
